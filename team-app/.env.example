# Paws & Paths environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
# `.env.local` is gitignored. NEVER commit real secrets, and never prefix a secret with
# NEXT_PUBLIC_ (that inlines it into the browser bundle).

# PostgreSQL connection string (Prisma). Used from feature/data-model onward.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/paws_and_paths"

# Auth.js v5. Generate the secret with: npx auth secret
AUTH_SECRET=""
# Auth.js only trusts the request host on its own in development and on Vercel. Uncomment this
# to run `npm run build && npm start` anywhere else (or set AUTH_URL to the site's origin);
# without it every production sign-in fails with an UntrustedHost error. Leave it commented out
# rather than empty: an empty value also switches host trust off in development.
# AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Development only: preview signed-in views before Auth.js is wired up.
# OWNER | WALKER | (empty = signed out). Ignored unless NODE_ENV=development.
DEV_MOCK_SESSION_ROLE=""
